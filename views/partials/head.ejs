<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>Keuangan KSR ASM Ariyanti</title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN dengan Palet KSR Ariyanti (Merah Kemanusiaan, Charcoal & White) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            "primary": "#0F172A",
            "primary-container": "#991B1B", /* Merah KSR Ariyanti */
            "primary-dark": "#7F1D1D",
            "on-primary": "#ffffff",
            "on-primary-container": "#FEE2E2",
            "secondary": "#B91C1C", /* Aksen Merah PMI / KSR */
            "secondary-container": "#FEE2E2",
            "on-secondary": "#ffffff",
            "on-secondary-container": "#7F1D1D",
            "surface": "#F8FAFC",
            "surface-container-lowest": "#ffffff",
            "surface-container-low": "#F1F5F9",
            "surface-container": "#E2E8F0",
            "surface-container-high": "#CBD5E1",
            "surface-container-highest": "#E2E8F0",
            "on-surface": "#0F172A",
            "on-surface-variant": "#64748B",
            "error": "#DC2626",
            "error-container": "#FEE2E2",
            "on-error": "#ffffff",
            "on-error-container": "#7F1D1D",
          },
          fontFamily: {
            sans: ["Inter", "-apple-system", "sans-serif"],
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-surface font-sans text-on-surface min-h-screen">

  <!-- Mobile Top Header (Clean & Pas di Layar) -->
  <header class="md:hidden fixed top-0 left-0 right-0 h-14 bg-primary-container z-50 flex items-center justify-between px-3 shadow-sm text-white">
    <div class="flex items-center gap-2">
      <button onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full'); document.getElementById('sidebar-overlay').classList.toggle('hidden')" class="p-1.5 rounded-lg hover:bg-white/10 active:bg-white/20" aria-label="Menu">
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
      <div class="flex items-center gap-1.5">
        <img src="/logo-ksr.png" alt="Logo KSR" class="w-6 h-6 object-contain bg-white rounded-md p-0.5">
        <span class="font-bold text-xs tracking-wide truncate max-w-[150px]">KSR ASM Ariyanti</span>
      </div>
    </div>
    <div class="flex items-center">
      <% if (isAdmin) { %>
        <span class="text-[10px] text-white bg-white/20 px-2 py-0.5 rounded-full font-semibold">Admin</span>
      <% } else { %>
        <a href="/login" class="text-[11px] text-secondary bg-white px-2.5 py-1 rounded-lg font-bold flex items-center gap-1 shadow-xs active:scale-95 transition-all">
          <span class="material-symbols-outlined text-[14px]">login</span> Masuk
        </a>
      <% } %>
    </div>
  </header>

  <!-- Sidebar (Warna Slate Halus dengan Logo KSR) -->
  <aside id="sidebar" class="fixed left-0 top-0 h-full w-64 bg-surface-container-low z-50 flex flex-col pt-6 pb-6 shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-r border-surface-container transition-transform duration-300 -translate-x-full md:translate-x-0">
    <!-- Brand dengan Logo Resmi KSR Ariyanti -->
    <div class="px-5 mb-6 flex items-center gap-3 pb-4 border-b border-surface-container">
      <div class="w-11 h-11 rounded-xl bg-white p-1 border border-surface-container shadow-xs shrink-0 flex items-center justify-center">
        <img src="/logo-ksr.png" alt="Logo KSR Ariyanti" class="w-full h-full object-contain">
      </div>
      <div>
        <div class="font-bold text-primary text-sm leading-tight">KSR ASM Ariyanti</div>
        <div class="text-[10px] text-secondary font-medium tracking-wide italic">Per Humanitas Ad Pacem</div>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 px-4 space-y-1.5 overflow-y-auto">
      <a href="/" class="flex items-center px-4 py-2.5 rounded-xl transition-all <%= currentPath === '/' ? 'bg-secondary text-white font-semibold shadow-xs' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>">
        <span class="material-symbols-outlined mr-3 text-[20px]">dashboard</span>
        Dashboard
      </a>
      <a href="/anggota" class="flex items-center px-4 py-2.5 rounded-xl transition-all <%= currentPath === '/anggota' ? 'bg-secondary text-white font-semibold shadow-xs' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>">
        <span class="material-symbols-outlined mr-3 text-[20px]">group</span>
        Daftar Anggota
      </a>

      <% if (isAdmin) { %>
        <a href="/kas-masuk" class="flex items-center px-4 py-2.5 rounded-xl transition-all <%= currentPath === '/kas-masuk' ? 'bg-secondary text-white font-semibold shadow-xs' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>">
          <span class="material-symbols-outlined mr-3 text-[20px]">south_west</span>
          Input Kas Masuk
        </a>
      <% } %>

      <a href="/pengeluaran" class="flex items-center px-4 py-2.5 rounded-xl transition-all <%= currentPath === '/pengeluaran' ? 'bg-secondary text-white font-semibold shadow-xs' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>">
        <span class="material-symbols-outlined mr-3 text-[20px]">north_east</span>
        Catat Pengeluaran
      </a>

      <% if (isAdmin) { %>
        <a href="/settings" class="flex items-center px-4 py-2.5 rounded-xl transition-all <%= currentPath === '/settings' ? 'bg-secondary text-white font-semibold shadow-xs' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>">
          <span class="material-symbols-outlined mr-3 text-[20px]">settings</span>
          Pengaturan
        </a>
      <% } %>

      <a href="/kas/cetak-lpj" target="_blank" class="flex items-center px-4 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all">
        <span class="material-symbols-outlined mr-3 text-[20px]">print</span>
        Cetak LPJ
      </a>

      <% if (!isAdmin) { %>
        <!-- Tombol Login Admin Langsung Masuk di Menu Utama -->
        <div class="pt-2">
          <a href="/login" class="flex items-center px-4 py-2.5 rounded-xl text-white font-semibold bg-secondary hover:bg-secondary/90 transition-all shadow-xs">
            <span class="material-symbols-outlined mr-3 text-[20px]">login</span>
            Login Admin
          </a>
        </div>
      <% } %>
    </nav>

    <!-- Sidebar Footer -->
    <div class="px-4 pt-4 border-t border-surface-container">
      <% if (isAdmin) { %>
        <div class="flex items-center justify-between mb-3 px-2">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center text-xs font-semibold">
              <%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
            </div>
            <div class="text-xs">
              <div class="font-semibold text-primary truncate max-w-[100px]"><%= user.username %></div>
              <div class="text-secondary font-semibold text-[10px]">Administrator</div>
            </div>
          </div>
        </div>
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-medium text-error hover:bg-error-container/50 transition-colors">
            <span class="material-symbols-outlined text-[18px]">logout</span>
            Keluar dari Sistem
          </button>
        </form>
      <% } else { %>
        <div class="p-3 rounded-xl bg-surface-container text-center mb-3">
          <div class="text-xs font-bold text-primary flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-[16px] text-secondary">visibility</span>
            Mode Publik
          </div>
          <div class="text-[11px] text-on-surface-variant mt-0.5">Hanya melihat data (read-only)</div>
        </div>
        <a href="/login" class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-xs font-semibold bg-secondary text-white hover:bg-secondary/90 transition-all shadow-xs">
          <span class="material-symbols-outlined text-[18px]">key</span>
          Masuk Administrator
        </a>
      <% } %>
    </div>
  </aside>

  <!-- Sidebar Overlay for Mobile -->
  <div onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden')" class="md:hidden fixed inset-0 bg-black/30 z-40 hidden" id="sidebar-overlay"></div>

  <!-- Main Content Wrapper -->
  <div class="md:pl-64 flex flex-col min-h-screen">
    <!-- Desktop Top Bar bernuansa KSR Merah & Charcoal -->
    <header class="hidden md:flex h-16 bg-primary-container items-center justify-between px-8 text-white sticky top-0 z-30 shadow-[0_1px_8px_rgba(0,0,0,0.06)] border-b border-primary-dark">
      <div class="flex items-center gap-3">
        <img src="/logo-ksr.png" alt="Logo KSR" class="w-7 h-7 object-contain bg-white rounded-md p-0.5">
        <span class="text-sm font-semibold tracking-wide">Sistem Informasi Keuangan Korps Sukarela (KSR) ASM Ariyanti</span>
      </div>
      <div class="flex items-center gap-3 text-xs">
        <% if (isAdmin) { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 text-white font-medium border border-white/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Mode Administrator
          </span>
        <% } else { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-white font-medium">
            <span class="material-symbols-outlined text-[14px]">visibility</span>
            Mode Publik (Lihat Saja)
          </span>
          <a href="/login" class="px-3 py-1 rounded-full bg-white text-secondary font-bold hover:bg-white/90 transition-all shadow-xs flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">login</span> Masuk Admin
          </a>
        <% } %>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="flex-1 p-3.5 sm:p-6 md:p-8 pt-16 sm:pt-20 md:pt-8 bg-surface">
