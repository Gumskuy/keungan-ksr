<% const pageTitle = 'Catat Pengeluaran' %>
<%- include('partials/head') %>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="px-3 py-1 rounded-full bg-surface-container-highest text-primary text-xs font-semibold uppercase tracking-wider">Arus Kas Keluar</span>
      <span class="text-on-surface-variant text-xs">Pencatatan Operasional KSR</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-primary tracking-tight">Catat Pengeluaran Dana Kas</h1>
    <p class="text-sm text-on-surface-variant mt-1">Dokumentasikan seluruh pengeluaran operasional, logistik P3K, diklat, dan kegiatan sukarela.</p>
  </div>
</div>

<% if (success) { %>
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">check_circle</span>
    <%= success %>
  </div>
<% } %>
<% if (error) { %>
  <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">error</span>
    <%= error %>
  </div>
<% } %>

<div class="grid grid-cols-1 <%= isAdmin ? 'lg:grid-cols-12' : '' %> gap-8">
  <% if (isAdmin) { %>
    <!-- Form Pengeluaran (Khusus Admin - 5 cols) -->
    <div class="lg:col-span-5">
      <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high sticky top-24">
        <div class="flex items-center gap-2.5 mb-6">
          <div class="w-9 h-9 rounded-xl bg-primary-container text-on-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
          </div>
          <div>
            <h2 class="text-base font-bold text-primary">Tambah Pengeluaran</h2>
            <p class="text-xs text-on-surface-variant">Catat biaya yang dikeluarkan.</p>
          </div>
        </div>

        <form method="POST" action="/pengeluaran" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div>
            <label class="block text-xs font-semibold text-primary mb-1.5">Tanggal Pengeluaran</label>
            <input type="date" name="tanggal_pengeluaran" required
              class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
          </div>

          <div>
            <label class="block text-xs font-semibold text-primary mb-1.5">Keterangan / Keperluan</label>
            <input type="text" name="keterangan" placeholder="Contoh: Pembelian obat P3K & perban"
              class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
          </div>

          <div>
            <label class="block text-xs font-semibold text-primary mb-1.5">Nominal (Rp)</label>
            <input type="number" name="nominal" min="1" placeholder="50000" required
              class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
          </div>

          <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-secondary text-white text-xs font-semibold hover:bg-secondary/90 transition-all shadow-xs flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">add</span>
            Simpan Pengeluaran
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <!-- Riwayat Pengeluaran -->
  <div class="<%= isAdmin ? 'lg:col-span-7' : 'w-full' %>">
    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-surface-container-high">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-base font-bold text-primary">Riwayat Pengeluaran Kas</h2>
          <p class="text-xs text-on-surface-variant">Diurutkan dari transaksi terbaru.</p>
        </div>
        <span class="px-3 py-1 rounded-full bg-surface-container-low text-xs font-semibold text-on-surface-variant">
          <%= pengeluaran.length %> Catatan
        </span>
      </div>

      <% if (pengeluaran.length === 0) { %>
        <div class="text-center py-12 text-on-surface-variant text-xs">
          <span class="material-symbols-outlined text-4xl mb-2 opacity-40">receipt</span>
          <p>Belum ada catatan pengeluaran kas.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto rounded-xl border border-surface-container">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-surface-container-low text-on-surface-variant uppercase text-[11px] font-semibold tracking-wider">
                <th class="py-3 px-4">Tanggal</th>
                <th class="py-3 px-4">Keterangan</th>
                <th class="py-3 px-4 text-right">Nominal</th>
                <% if (isAdmin) { %>
                  <th class="py-3 px-4 w-16 text-right">Aksi</th>
                <% } %>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-container">
              <% pengeluaran.forEach(function(p) { 
                const tgl = p.tanggal_pengeluaran instanceof Date ? p.tanggal_pengeluaran : new Date(p.tanggal_pengeluaran);
                const d = tgl.getDate() + '/' + (tgl.getMonth()+1) + '/' + tgl.getFullYear();
              %>
                <tr class="hover:bg-surface-container-low/60 transition-colors">
                  <td class="py-3 px-4 text-on-surface-variant whitespace-nowrap"><%= d %></td>
                  <td class="py-3 px-4 font-medium text-primary"><%= p.keterangan || '-' %></td>
                  <td class="py-3 px-4 text-right font-bold text-error whitespace-nowrap"><%= formatRupiah(p.nominal) %></td>
                  <% if (isAdmin) { %>
                    <td class="py-3 px-4 text-right">
                      <form method="POST" action="/pengeluaran/hapus/<%= p.id %>" style="display:inline"
                        onsubmit="return confirm('Yakin ingin menghapus catatan pengeluaran ini?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="p-1.5 rounded-lg text-error hover:bg-error-container/40 transition-colors" title="Hapus">
                          <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                      </form>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
