<% const pageTitle = 'Input Kas Masuk' %>
<%- include('partials/head') %>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="px-3 py-1 rounded-full bg-secondary-container/40 text-secondary text-xs font-semibold uppercase tracking-wider">Transaksi Kas</span>
      <span class="text-on-surface-variant text-xs">Pencatatan Iuran Multi-Minggu</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-primary tracking-tight">Input Pembayaran Uang Kas</h1>
    <p class="text-sm text-on-surface-variant mt-1">Catat pembayaran iuran kas sukarelawan untuk satu minggu sekaligus maupun banyak minggu (borongan).</p>
  </div>
</div>

<% if (success) { %>
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">check_circle</span>
    <%= success %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">error</span>
    <%= error %>
  </div>
<% } %>

<!-- Mini Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
  <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-surface-container-high flex items-center justify-between">
    <div>
      <div class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold mb-1">Tarif Kas Mingguan</div>
      <div class="text-2xl font-bold text-primary"><%= formatRupiah(TARIF_KAS) %></div>
      <div class="text-xs text-secondary mt-1">Per anggota setiap periode 7 hari</div>
    </div>
    <div class="w-12 h-12 rounded-xl bg-secondary-container/30 text-secondary flex items-center justify-center">
      <span class="material-symbols-outlined text-[24px]">payments</span>
    </div>
  </div>

  <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-surface-container-high flex items-center justify-between">
    <div>
      <div class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold mb-1">Tarif Denda Keterlambatan</div>
      <div class="text-2xl font-bold text-error"><%= formatRupiah(TARIF_DENDA) %></div>
      <div class="text-xs text-on-surface-variant mt-1">Bagi anggota yang lewat tenggat waktu</div>
    </div>
    <div class="w-12 h-12 rounded-xl bg-error-container/30 text-error flex items-center justify-center">
      <span class="material-symbols-outlined text-[24px]">warning</span>
    </div>
  </div>
</div>

<!-- Main Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- Form Input (8 cols) -->
  <div class="lg:col-span-8">
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-lg font-bold text-primary">Formulir Kas Masuk</h2>
          <p class="text-xs text-on-surface-variant">Pilih anggota dan centang minggu-minggu yang dibayar (bisa lebih dari satu minggu sekaligus).</p>
        </div>
        <div class="w-9 h-9 rounded-xl bg-primary-container text-on-primary flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">add_card</span>
        </div>
      </div>

      <form method="POST" action="/kas-masuk" class="space-y-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Pilih Anggota -->
        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Pilih Anggota KSR (A-Z) <span class="text-error">*</span></label>
          <div class="relative">
            <select name="anggota_id" required
              class="w-full bg-surface-container-low text-on-surface px-4 py-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-secondary appearance-none border border-transparent focus:border-secondary transition-all">
              <option value="" disabled selected>— Pilih nama sukarelawan —</option>
              <% anggota.forEach(function(a) { %>
                <option value="<%= a.id %>"><%= a.nama %></option>
              <% }) %>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
          </div>
        </div>

        <!-- Pilih Periode Minggu (Checkbox Grid + Quick Buttons) -->
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <label class="block text-xs font-semibold text-primary">
              Centang Periode Minggu yang Dibayar <span class="text-error">*</span>
            </label>
            <!-- Tombol Cepat Multi-Select -->
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[11px] text-on-surface-variant mr-1">Pilih cepat:</span>
              <button type="button" onclick="selectFirstNWeeks(1)" class="px-2 py-1 rounded-lg bg-surface-container hover:bg-surface-container-high text-[11px] font-semibold text-primary transition-all">
                1 Mgg
              </button>
              <button type="button" onclick="selectFirstNWeeks(5)" class="px-2 py-1 rounded-lg bg-surface-container hover:bg-surface-container-high text-[11px] font-semibold text-primary transition-all">
                5 Mgg
              </button>
              <button type="button" onclick="selectFirstNWeeks(10)" class="px-2 py-1 rounded-lg bg-surface-container hover:bg-surface-container-high text-[11px] font-semibold text-primary transition-all">
                10 Mgg
              </button>
              <button type="button" onclick="selectAllWeeks(true)" class="px-2 py-1 rounded-lg bg-surface-container hover:bg-surface-container-high text-[11px] font-semibold text-secondary transition-all">
                Semua
              </button>
              <button type="button" onclick="selectAllWeeks(false)" class="px-2 py-1 rounded-lg bg-error-container/40 hover:bg-error-container text-[11px] font-semibold text-error transition-all">
                Reset
              </button>
            </div>
          </div>

          <!-- Container Checkbox 52 Minggu -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 max-h-72 overflow-y-auto p-3 bg-surface-container-low rounded-2xl border border-surface-container">
            <% weeks.forEach(function(w, idx) { %>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-lowest border border-surface-container hover:border-secondary cursor-pointer transition-all select-none group has-[:checked]:border-secondary has-[:checked]:bg-secondary-container/15">
                <input type="checkbox" name="tanggal_periode" value="<%= w.dateStr %>"
                  class="w-4 h-4 rounded text-secondary focus:ring-secondary week-checkbox accent-secondary"
                  onchange="updateWeekSummary()">
                <div class="truncate">
                  <div class="font-bold text-primary text-xs">M<%= w.number %></div>
                  <div class="text-[10px] text-on-surface-variant"><%= formatTgl(w.from) %> - <%= formatTgl(w.to) %></div>
                </div>
              </label>
            <% }) %>
          </div>

          <!-- Live Summary Terpilih -->
          <div class="mt-3 p-3.5 bg-secondary-container/20 border border-secondary-container/40 rounded-xl flex items-center justify-between text-xs text-primary font-medium">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_box</span>
              <span>Terpilih: <strong id="selectedWeekCount" class="font-bold text-secondary text-sm">0</strong> minggu</span>
            </span>
            <span>Total Iuran: <strong id="selectedTotalKas" class="font-bold text-primary text-sm">Rp 0</strong></span>
          </div>
        </div>

        <!-- Status Pembayaran & Denda -->
        <div class="p-4 rounded-xl bg-surface-container-low/60 border border-surface-container space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" name="apakah_bayar" checked class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-600 accent-emerald-600">
            <span class="text-xs font-semibold text-primary flex items-center gap-1.5">
              <span class="w-4 h-4 rounded bg-emerald-600 text-white inline-flex items-center justify-center"><svg class="w-2.5 h-2.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
              Tandai Sudah Bayar Kas (Rp <%= TARIF_KAS.toLocaleString('id-ID') %> per minggu)
            </span>
          </label>

          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" name="kena_denda" class="w-4 h-4 rounded text-amber-500 focus:ring-amber-500 accent-amber-500">
            <span class="text-xs font-semibold text-amber-800 flex items-center gap-1.5">
              <span class="w-4 h-4 rounded bg-amber-500 text-white inline-flex items-center justify-center font-bold text-[10px]">!</span>
              Tandai Kena Denda Keterlambatan (Rp <%= TARIF_DENDA.toLocaleString('id-ID') %> per minggu)
            </span>
          </label>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-primary-container text-on-primary text-xs font-semibold hover:bg-primary transition-all shadow-sm flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Simpan Transaksi Kas Terpilih
        </button>
      </form>
    </div>
  </div>

  <!-- Info Card (4 cols) -->
  <div class="lg:col-span-4">
    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-surface-container-high space-y-4 sticky top-24">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-secondary-container/40 text-secondary flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]">lightbulb</span>
        </div>
        <h3 class="text-sm font-bold text-primary">Keuntungan Bayar Sekaligus</h3>
      </div>
      <p class="text-xs text-on-surface-variant leading-relaxed">
        Jika ada anggota yang membayar langsung <strong>5 minggu</strong> atau <strong>10 minggu</strong> ke depan, Anda cukup memilih namanya dan mencentang minggu yang diinginkan. Semua data langsung tersimpan dalam sekali klik!
      </p>

      <div class="p-3.5 rounded-xl bg-surface-container-low text-xs space-y-2 border border-surface-container">
        <div class="font-semibold text-primary">Simulasi Pembayaran:</div>
        <ul class="text-[11px] text-on-surface-variant space-y-1">
          <li>• 1 Minggu = Rp 5.000</li>
          <li>• 5 Minggu = Rp 25.000</li>
          <li>• 10 Minggu = Rp 50.000</li>
          <li>• 52 Minggu (1 Tahun) = Rp 260.000</li>
        </ul>
      </div>

      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-secondary hover:underline pt-2">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        Kembali ke Dashboard
      </a>
    </div>
  </div>
</div>

<script>
const TARIF_KAS = <%= TARIF_KAS %>;

function formatRp(n) {
  return 'Rp ' + (n||0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

function updateWeekSummary() {
  const checkboxes = document.querySelectorAll('.week-checkbox:checked');
  const count = checkboxes.length;
  document.getElementById('selectedWeekCount').textContent = count;
  document.getElementById('selectedTotalKas').textContent = formatRp(count * TARIF_KAS);
}

function selectFirstNWeeks(n) {
  const checkboxes = document.querySelectorAll('.week-checkbox');
  checkboxes.forEach((cb, idx) => {
    cb.checked = idx < n;
  });
  updateWeekSummary();
}

function selectAllWeeks(checked) {
  const checkboxes = document.querySelectorAll('.week-checkbox');
  checkboxes.forEach((cb) => {
    cb.checked = checked;
  });
  updateWeekSummary();
}
</script>

<%- include('partials/foot') %>
