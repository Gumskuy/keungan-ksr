<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masuk — Keuangan KSR ASM Ariyanti</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            "primary": "#0F172A",
            "primary-container": "#991B1B",
            "secondary": "#B91C1C",
            "secondary-container": "#FEE2E2",
            "surface": "#F8FAFC",
            "surface-container-lowest": "#ffffff",
            "surface-container-low": "#F1F5F9",
            "surface-container": "#E2E8F0",
            "on-surface": "#0F172A",
            "on-surface-variant": "#64748B",
            "error": "#DC2626",
          },
          fontFamily: {
            sans: ["Inter", "-apple-system", "sans-serif"],
          }
        }
      }
    };
  </script>
</head>
<body class="bg-surface font-sans text-on-surface min-h-screen flex items-center justify-center p-4">

  <div class="w-full max-w-md bg-surface-container-lowest rounded-3xl p-8 md:p-10 shadow-[0_4px_24px_rgba(0,0,0,0.06)] border border-surface-container relative overflow-hidden">
    <!-- Subtle glow circle in background -->
    <div class="absolute -top-16 -right-16 w-44 h-44 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Brand Header dengan Logo KSR -->
    <div class="text-center mb-8 relative">
      <div class="w-20 h-20 mx-auto mb-3 p-1.5 bg-white rounded-2xl border border-surface-container shadow-xs flex items-center justify-center">
        <img src="/logo-ksr.png" alt="Logo KSR ASM Ariyanti" class="w-full h-full object-contain">
      </div>
      <h1 class="text-xl md:text-2xl font-bold text-primary tracking-tight">Data Keuangan KSR</h1>
      <p class="text-xs font-semibold text-secondary mt-0.5">Korps Sukarela ASM Ariyanti</p>
      <p class="text-[11px] text-on-surface-variant italic mt-0.5">Per Humanitas Ad Pacem</p>
    </div>

    <% if (error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">error</span>
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="username" class="block text-xs font-semibold text-primary mb-1.5">Username</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3.5 top-3 text-on-surface-variant text-[18px]">person</span>
          <input type="text" id="username" name="username" required autofocus placeholder="Masukkan username"
            class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold text-primary mb-1.5">Password</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3.5 top-3 text-on-surface-variant text-[18px]">lock</span>
          <input type="password" id="password" name="password" required placeholder="Masukkan password"
            class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>
      </div>

      <button type="submit" class="w-full py-3 px-4 rounded-xl bg-secondary text-white text-xs font-semibold hover:bg-secondary/90 transition-all shadow-xs flex items-center justify-center gap-2 mt-2">
        <span class="material-symbols-outlined text-[18px]">login</span>
        Masuk Administrator
      </button>
    </form>

    <div class="mt-8 text-center border-t border-surface-container pt-4 text-[11px] text-on-surface-variant">
      Proteksi Keamanan: Maksimal 10 percobaan per 15 menit
    </div>
  </div>

</body>
</html>
