<% const pageTitle = 'Pengaturan Akun' %>
<%- include('partials/head') %>

<h1 class="page-title">Pengaturan Akun</h1>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="card form-card">
  <form method="POST" action="/settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="username">Username Baru</label>
      <input type="text" id="username" name="username" value="<%= user.username %>" placeholder="Kosongkan jika tidak ingin mengubah">
      <small class="text-secondary">Kosongkan jika tidak ingin mengubah username</small>
    </div>

    <hr class="divider">

    <div class="form-group">
      <label for="password_lama">Password Lama <span class="required">*</span></label>
      <input type="password" id="password_lama" name="password_lama" required placeholder="Masukkan password saat ini">
    </div>

    <div class="form-group">
      <label for="password_baru">Password Baru</label>
      <input type="password" id="password_baru" name="password_baru" placeholder="Kosongkan jika tidak ingin mengubah">
    </div>

    <div class="form-group">
      <label for="password_konfirmasi">Konfirmasi Password Baru</label>
      <input type="password" id="password_konfirmasi" name="password_konfirmasi" placeholder="Ulangi password baru">
    </div>

    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
  </form>
</div>

<%- include('partials/foot') %>