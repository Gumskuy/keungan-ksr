<% const pageTitle = 'Pengaturan' %>
<%- include('partials/head') %>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="px-3 py-1 rounded-full bg-secondary-container/40 text-secondary text-xs font-semibold uppercase tracking-wider">Konfigurasi</span>
      <span class="text-on-surface-variant text-xs">Akun & Cadangan Data</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-primary tracking-tight">Pengaturan Akun & Sistem</h1>
    <p class="text-sm text-on-surface-variant mt-1">Ubah identitas akun administrator dan kelola cadangan (auto-backup) mingguan.</p>
  </div>
</div>

<% if (success) { %>
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">check_circle</span>
    <%= success %>
  </div>
<% } %>
<% if (error) { %>
  <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">error</span>
    <%= error %>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- Ganti Username & Password (6 cols) -->
  <div class="lg:col-span-6">
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high">
      <div class="flex items-center gap-2.5 mb-6">
        <div class="w-9 h-9 rounded-xl bg-primary-container text-on-primary flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
        </div>
        <div>
          <h2 class="text-base font-bold text-primary">Kredensial Akun</h2>
          <p class="text-xs text-on-surface-variant">Ubah username atau kata sandi admin.</p>
        </div>
      </div>

      <form method="POST" action="/settings" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Username Baru</label>
          <input type="text" name="username" value="<%= user.username %>" placeholder="Kosongkan jika tidak diubah"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
          <p class="text-[11px] text-on-surface-variant mt-1">Username yang dipakai saat login.</p>
        </div>

        <hr class="border-surface-container my-4">

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Password Lama <span class="text-error">*</span></label>
          <input type="password" name="password_lama" required placeholder="Masukkan password saat ini"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Password Baru</label>
          <input type="password" name="password_baru" placeholder="Kosongkan jika tidak ingin ganti"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Konfirmasi Password Baru</label>
          <input type="password" name="password_konfirmasi" placeholder="Ulangi password baru"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-primary-container text-on-primary text-xs font-semibold hover:bg-primary transition-all shadow-sm flex items-center justify-center gap-2 mt-2">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Simpan Perubahan Akun
        </button>
      </form>
    </div>
  </div>

  <!-- Auto Backup Database (6 cols) -->
  <div class="lg:col-span-6">
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high space-y-6">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-secondary-container/40 text-secondary flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">backup</span>
        </div>
        <div>
          <h2 class="text-base font-bold text-primary">Auto-Backup Database Mingguan</h2>
          <p class="text-xs text-on-surface-variant">Cadangan data lokal terjadwal otomatis.</p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-surface-container-low border border-surface-container text-xs space-y-2">
        <div class="font-semibold text-primary flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-secondary">schedule</span>
          Status Penjadwal Otomatis:
        </div>
        <p class="text-on-surface-variant leading-relaxed">
          Database otomatis dibackup setiap <strong>7 hari sekali</strong> ke direktori lokal (folder <code>./backups/</code>). Backup disimpan selama 8 minggu terakhir.
        </p>
      </div>

      <!-- Action buttons -->
      <div class="space-y-2.5">
        <form method="POST" action="/settings/backup/create">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-secondary text-white text-xs font-semibold hover:bg-secondary/90 transition-all shadow-sm flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">sync</span>
            Buat Backup Sekarang (Manual)
          </button>
        </form>

        <div class="grid grid-cols-2 gap-2.5">
          <a href="/settings/backup/download/json" download class="py-2.5 px-3 rounded-xl bg-surface-container text-on-surface text-xs font-semibold hover:bg-surface-container-high transition-all border border-surface-container-highest flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">download</span>
            Unduh JSON
          </a>
          <a href="/settings/backup/download/sql" download class="py-2.5 px-3 rounded-xl bg-surface-container text-on-surface text-xs font-semibold hover:bg-surface-container-high transition-all border border-surface-container-highest flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">download</span>
            Unduh SQL Restore
          </a>
        </div>
      </div>

      <!-- Recent backup files -->
      <div>
        <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3">Daftar File Cadangan di Server:</h3>
        <% if (backups && backups.length > 0) { %>
          <ul class="divide-y divide-surface-container border border-surface-container rounded-xl overflow-hidden text-xs">
            <% backups.forEach(function(b) { %>
              <li class="p-3 bg-surface-container-low/40 flex items-center justify-between hover:bg-surface-container-low transition-colors">
                <div class="flex items-center gap-2 truncate pr-2">
                  <span class="material-symbols-outlined text-[16px] text-on-surface-variant">description</span>
                  <span class="font-mono text-[11px] truncate"><%= b.filename %></span>
                </div>
                <div class="text-[10px] text-on-surface-variant whitespace-nowrap"><%= b.sizeKb %> KB • <%= b.createdAt %></div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-xs text-on-surface-variant italic">Belum ada file backup di server.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
