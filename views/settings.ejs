<% const pageTitle = 'Pengaturan' %>
<%- include('partials/head') %>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="px-3 py-1 rounded-full bg-secondary-container/40 text-secondary text-xs font-semibold uppercase tracking-wider">Konfigurasi</span>
      <span class="text-on-surface-variant text-xs">Akun & Cadangan Data</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-primary tracking-tight">Pengaturan Akun & Sistem</h1>
    <p class="text-sm text-on-surface-variant mt-1">Ubah identitas akun administrator dan kelola cadangan (auto-backup) mingguan.</p>
  </div>
</div>

<% if (success) { %>
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">check_circle</span>
    <%= success %>
  </div>
<% } %>
<% if (error) { %>
  <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
    <span class="material-symbols-outlined text-[20px]">error</span>
    <%= error %>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- Sisi Kiri: Manajemen Akun Administrator (6 cols) -->
  <div class="lg:col-span-6 space-y-6">
    <!-- Ganti Username & Password Sendiri -->
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high">
      <div class="flex items-center gap-2.5 mb-6">
        <div class="w-9 h-9 rounded-xl bg-primary-container text-on-primary flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
        </div>
        <div>
          <h2 class="text-base font-bold text-primary">Kredensial Akun Saya</h2>
          <p class="text-xs text-on-surface-variant">Ubah username atau kata sandi akun Anda yang sedang aktif (<strong class="text-secondary"><%= user.username %></strong>).</p>
        </div>
      </div>

      <form method="POST" action="/settings" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Username Baru</label>
          <input type="text" name="username" value="<%= user.username %>" placeholder="Kosongkan jika tidak diubah"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <hr class="border-surface-container my-3">

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Password Lama <span class="text-error">*</span></label>
          <input type="password" name="password_lama" required placeholder="Masukkan password saat ini"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Password Baru</label>
          <input type="password" name="password_baru" placeholder="Kosongkan jika tidak ingin ganti"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <div>
          <label class="block text-xs font-semibold text-primary mb-1.5">Konfirmasi Password Baru</label>
          <input type="password" name="password_konfirmasi" placeholder="Ulangi password baru"
            class="w-full px-4 py-2.5 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-transparent focus:border-secondary transition-all">
        </div>

        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-secondary text-white text-xs font-semibold hover:bg-secondary/90 transition-all shadow-xs flex items-center justify-center gap-2 mt-2">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Simpan Perubahan Akun Saya
        </button>
      </form>
    </div>

    <!-- Tambah Admin Baru & Daftar Admin -->
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high space-y-6">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-secondary-container/40 text-secondary flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">person_add</span>
        </div>
        <div>
          <h2 class="text-base font-bold text-primary">Kelola Administrator Lain</h2>
          <p class="text-xs text-on-surface-variant">Tambahkan akun login baru untuk pengurus / bendahara lain.</p>
        </div>
      </div>

      <!-- Form Tambah Admin Baru -->
      <form method="POST" action="/settings/users/create" class="p-4 rounded-xl bg-surface-container-low border border-surface-container space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-xs font-bold text-primary flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-secondary">add_circle</span>
          Tambah Admin Baru
        </h3>

        <div>
          <label class="block text-[11px] font-semibold text-primary mb-1">Username Baru</label>
          <input type="text" name="new_username" required placeholder="Contoh: bendahara2"
            class="w-full px-3 py-2 bg-white rounded-lg text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-surface-container">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div>
            <label class="block text-[11px] font-semibold text-primary mb-1">Password Baru</label>
            <input type="password" name="new_password" required minlength="6" placeholder="Minimal 6 karakter"
              class="w-full px-3 py-2 bg-white rounded-lg text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-surface-container">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-primary mb-1">Ulangi Password</label>
            <input type="password" name="confirm_password" required minlength="6" placeholder="Konfirmasi password"
              class="w-full px-3 py-2 bg-white rounded-lg text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary border border-surface-container">
          </div>
        </div>

        <button type="submit" class="w-full py-2 px-3 rounded-lg bg-primary text-white text-xs font-semibold hover:bg-primary/90 transition-all flex items-center justify-center gap-1.5 shadow-2xs mt-1">
          <span class="material-symbols-outlined text-[16px]">check</span>
          Buat Akun Administrator
        </button>
      </form>

      <!-- Daftar Seluruh Admin -->
      <div>
        <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-2.5">Daftar Akun Administrator Terdaftar:</h3>
        <% if (typeof usersList !== 'undefined' && usersList.length > 0) { %>
          <div class="divide-y divide-surface-container border border-surface-container rounded-xl overflow-hidden text-xs">
            <% usersList.forEach(function(u) { 
              const isSelf = u.id === user.id;
            %>
              <div class="p-3 bg-white flex items-center justify-between hover:bg-surface-container-low transition-colors">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full <%= isSelf ? 'bg-secondary text-white' : 'bg-surface-container text-primary' %> flex items-center justify-center font-bold text-[10px]">
                    <%= u.username.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <div class="font-bold text-primary flex items-center gap-1.5">
                      <%= u.username %>
                      <% if (isSelf) { %>
                        <span class="px-1.5 py-0.2 rounded bg-secondary-container text-secondary text-[9px] font-semibold">Akun Anda</span>
                      <% } %>
                    </div>
                    <div class="text-[10px] text-on-surface-variant">Hak akses: Administrator Penuh</div>
                  </div>
                </div>

                <% if (!isSelf && usersList.length > 1) { %>
                  <form method="POST" action="/settings/users/delete/<%= u.id %>" onsubmit="return confirm('Yakin ingin menghapus akses admin untuk <%= u.username %>?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 text-[11px] font-semibold transition-all border border-rose-200 flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">delete</span>
                      Hapus
                    </button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sisi Kanan: Status Database & Cadangan Excel / SQL (6 cols) -->
  <div class="lg:col-span-6 space-y-6">
    <!-- Status Penyimpanan Database & Keamanan Periode -->
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high space-y-4">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">cloud_done</span>
        </div>
        <div>
          <h2 class="text-base font-bold text-primary">Kapasitas & Ketahanan Database</h2>
          <p class="text-xs text-on-surface-variant">Sistem Penyimpanan Cloud PostgreSQL Supabase.</p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200 text-xs space-y-2 text-emerald-900 leading-relaxed">
        <div class="font-bold flex items-center gap-1.5 text-emerald-800">
          <span class="material-symbols-outlined text-[18px]">verified</span>
          Database Aman & Tidak Akan Penuh / Kosong Sendiri:
        </div>
        <p>
          1. <strong>Kapasitas Super Luang:</strong> Cloud database Supabase memberikan kuota <strong>500 MB</strong> gratis. Seluruh catatan kas KSR (52 minggu) saat ini baru memakai sekitar <strong>0.1 MB (&lt; 0.02%)</strong>, sehingga tidak akan pernah penuh.
        </p>
        <p>
          2. <strong>Data Permanen:</strong> Data tidak akan pernah hilang atau terhapus sendiri saat melewati batas 10 minggu. Batas 10 minggu di dashboard hanyalah <em>tampilan halaman (tab/pagination)</em> agar layar HP tidak kepanjangan.
        </p>
      </div>
    </div>

    <!-- Export & Cadangan Excel (.xlsx) -->
    <div class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl shadow-sm border border-surface-container-high space-y-6">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-xs">
          <span class="material-symbols-outlined text-[20px]">table_view</span>
        </div>
        <div>
          <h2 class="text-base font-bold text-primary">Export & Cadangan Excel (.xlsx)</h2>
          <p class="text-xs text-on-surface-variant">Unduh arsip spreadsheet resmi yang bisa dibuka di Excel, Sheets, atau WPS.</p>
        </div>
      </div>

      <div class="space-y-3">
        <div class="p-4 rounded-xl bg-surface-container-low border border-surface-container space-y-2 text-xs">
          <div class="font-bold text-primary flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-emerald-700">description</span>
            Format File Excel Resmi (.xlsx):
          </div>
          <p class="text-on-surface-variant leading-relaxed">
            File Excel berisi 3 lembar kerja otomatis: <strong>Ringkasan Saldo</strong>, <strong>Rekap Kas Anggota per Minggu</strong>, dan <strong>Daftar Pengeluaran</strong> lengkap dengan rumus total.
          </p>
        </div>

        <!-- Tombol Download Excel -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <a href="/kas/export-excel?batch=all" class="py-3 px-4 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition-all shadow-xs flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">file_download</span>
            Unduh Excel (52 Minggu Penuh)
          </a>
          <a href="/kas/export-excel?batch=0" class="py-3 px-4 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-300 text-xs font-bold hover:bg-emerald-100 transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">calendar_view_week</span>
            Unduh Excel (10 Minggu Pertama)
          </a>
        </div>
      </div>

      <!-- Backup Teknis Lainnya -->
      <div class="pt-4 border-t border-surface-container space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider">Cadangan Teknis (JSON & SQL):</h3>
          <form method="POST" action="/settings/backup/create">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-[11px] font-semibold text-secondary hover:underline flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">sync</span>
              Buat Snapshot Sekarang
            </button>
          </form>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <a href="/settings/backup/download/json" download class="py-2 px-3 rounded-lg bg-surface-container text-on-surface text-[11px] font-semibold hover:bg-surface-container-high transition-all border border-surface-container-highest flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-[15px]">code</span>
            Unduh Data JSON
          </a>
          <a href="/settings/backup/download/sql" download class="py-2 px-3 rounded-lg bg-surface-container text-on-surface text-[11px] font-semibold hover:bg-surface-container-high transition-all border border-surface-container-highest flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-[15px]">database</span>
            Unduh SQL Restore
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
