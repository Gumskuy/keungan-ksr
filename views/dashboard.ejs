<% const pageTitle = 'Dashboard Ringkas' %>
<%- include('partials/head') %>

<!-- Top Section / Official Header with Logo KSR Ariyanti -->
<div class="bg-surface-container-lowest p-4 sm:p-6 rounded-2xl border border-surface-container shadow-xs mb-5 flex flex-col sm:flex-row items-center sm:items-start justify-between gap-4 text-center sm:text-left">
  <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4">
    <!-- Official Logo KSR (Tampilan Statis / Non-Editable) -->
    <div class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 bg-white p-1 rounded-2xl border border-surface-container shadow-xs flex items-center justify-center select-none pointer-events-none">
      <img src="/logo-ksr.png" alt="Logo KSR ASM Ariyanti" class="w-full h-full object-contain">
    </div>
    <div>
      <div class="flex items-center justify-center sm:justify-start gap-1.5 mb-1 flex-wrap">
        <span class="px-2 py-0.5 rounded-full bg-secondary text-white text-[9px] font-bold tracking-wider uppercase">KORPS SUKARELA</span>
        <span class="px-2 py-0.5 rounded-full bg-secondary-container text-secondary text-[9px] font-semibold">Periode 2026/2027</span>
      </div>
      <h1 class="text-base sm:text-xl font-bold text-primary tracking-tight">Data Keuangan KSR ASM Ariyanti</h1>
      <p class="text-[11px] sm:text-xs text-on-surface-variant mt-0.5 max-w-xl">Rekapitulasi iuran kas anggota, denda kedisiplinan, dan operasional sukarelawan.</p>
    </div>
  </div>
  <div class="shrink-0">
    <a href="/kas/cetak-lpj" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-secondary text-white text-xs font-semibold hover:bg-secondary/90 transition-all shadow-xs">
      <span class="material-symbols-outlined text-[16px]">print</span>
      Cetak LPJ
    </a>
  </div>
</div>

<!-- Info Banner for Public Mode -->
<% if (!isAdmin) { %>
  <div class="mb-6 p-4 rounded-2xl bg-secondary-container/50 border border-secondary/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-primary shadow-xs">
    <div class="flex items-center gap-2.5">
      <span class="material-symbols-outlined text-secondary text-[22px]">info</span>
      <span><strong>Mode Lihat Saja (Publik):</strong> Anda dapat memantau data iuran kas anggota secara transparan. Kotak centang dikunci dan hanya dapat diedit oleh Administrator.</span>
    </div>
    <a href="/login" class="px-3.5 py-1.5 rounded-xl bg-secondary text-white font-semibold hover:bg-secondary/90 transition-all whitespace-nowrap shadow-xs flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[16px]">key</span> Masuk Admin
    </a>
  </div>
<% } %>

<!-- 4 Summary Cards (Warna Harmonis KSR Ariyanti - 2 Kolom di HP) -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-6 sm:mb-8">
  <!-- Card 1: Total Kas Masuk -->
  <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-6 shadow-xs border border-surface-container relative overflow-hidden group hover:shadow-md transition-all">
    <div class="absolute right-0 top-0 w-24 h-24 bg-emerald-50 rounded-full blur-2xl -mr-6 -mt-6 pointer-events-none"></div>
    <div class="flex items-center justify-between mb-2 sm:mb-4">
      <span class="text-[10px] sm:text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Total Kas Masuk</span>
      <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
        <span class="material-symbols-outlined text-[18px] sm:text-[20px]">south_west</span>
      </div>
    </div>
    <div class="text-lg sm:text-2xl font-bold text-primary mb-1" id="val-kas"><%= formatRupiah(totalKas) %></div>
    <div class="flex items-center gap-1 text-[10px] sm:text-xs text-emerald-700 font-medium truncate">
      <span class="material-symbols-outlined text-[14px] sm:text-[16px] shrink-0">payments</span>
      <span>Tarif <%= formatRupiah(TARIF_KAS) %></span>
    </div>
  </div>

  <!-- Card 2: Total Denda Masuk -->
  <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-6 shadow-xs border border-surface-container relative overflow-hidden group hover:shadow-md transition-all">
    <div class="absolute right-0 top-0 w-24 h-24 bg-rose-50 rounded-full blur-2xl -mr-6 -mt-6 pointer-events-none"></div>
    <div class="flex items-center justify-between mb-2 sm:mb-4">
      <span class="text-[10px] sm:text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Total Denda</span>
      <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-rose-50 text-secondary flex items-center justify-center">
        <span class="material-symbols-outlined text-[18px] sm:text-[20px]">warning</span>
      </div>
    </div>
    <div class="text-lg sm:text-2xl font-bold text-primary mb-1" id="val-denda"><%= formatRupiah(totalDenda) %></div>
    <div class="flex items-center gap-1 text-[10px] sm:text-xs text-secondary font-medium truncate">
      <span class="material-symbols-outlined text-[14px] sm:text-[16px] shrink-0">info</span>
      <span>Denda <%= formatRupiah(TARIF_DENDA) %></span>
    </div>
  </div>

  <!-- Card 3: Total Pengeluaran -->
  <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-6 shadow-xs border border-surface-container relative overflow-hidden group hover:shadow-md transition-all">
    <div class="absolute right-0 top-0 w-24 h-24 bg-surface-container rounded-full blur-2xl -mr-6 -mt-6 pointer-events-none"></div>
    <div class="flex items-center justify-between mb-2 sm:mb-4">
      <span class="text-[10px] sm:text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Pengeluaran</span>
      <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-surface-container-low text-on-surface-variant flex items-center justify-center">
        <span class="material-symbols-outlined text-[18px] sm:text-[20px]">north_east</span>
      </div>
    </div>
    <div class="text-lg sm:text-2xl font-bold text-primary mb-1" id="val-pengeluaran"><%= formatRupiah(totalPengeluaran) %></div>
    <div class="flex items-center gap-1 text-[10px] sm:text-xs text-on-surface-variant truncate">
      <span class="material-symbols-outlined text-[14px] sm:text-[16px] shrink-0">receipt_long</span>
      <span>Operasional</span>
    </div>
  </div>

  <!-- Card 4: Sisa Saldo Kas Bersih -->
  <div class="bg-primary-container text-white rounded-2xl p-4 sm:p-6 shadow-sm border border-primary-dark relative overflow-hidden group hover:shadow-md transition-all">
    <div class="absolute right-0 top-0 w-32 h-32 bg-white/10 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>
    <div class="flex items-center justify-between mb-2 sm:mb-4">
      <span class="text-[10px] sm:text-xs text-red-200 uppercase tracking-wider font-semibold">Saldo Bersih</span>
      <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-white/15 flex items-center justify-center text-white">
        <span class="material-symbols-outlined text-[18px] sm:text-[20px]">account_balance_wallet</span>
      </div>
    </div>
    <div class="text-lg sm:text-2xl font-bold text-white mb-1" id="val-saldo"><%= formatRupiah(sisaSaldo) %></div>
    <div class="flex items-center gap-1 text-[10px] sm:text-xs text-red-100 font-medium truncate">
      <span class="material-symbols-outlined text-[14px] sm:text-[16px] shrink-0">check_circle</span>
      <span>Kas - Keluar</span>
    </div>
  </div>
</div>

<!-- Interactive Payment Ledger Section -->
<div class="bg-surface-container-lowest rounded-2xl shadow-xs border border-surface-container p-6 mb-8">
  <!-- Toolbar Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
    <div>
      <h2 class="text-lg font-bold text-primary">Tabel Pembayaran Uang Kas Anggota KSR</h2>
      <p class="text-xs text-on-surface-variant">
        <% if (isAdmin) { %>
          Klik kotak centang di tabel untuk mengubah status pembayaran langsung.
        <% } else { %>
          Daftar rekapitulasi iuran kas dan denda kedisiplinan 52 minggu.
        <% } %>
      </p>
    </div>
    <div class="flex items-center gap-3 w-full sm:w-auto">
      <div class="relative w-full sm:w-72">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[18px]">search</span>
        <input type="text" id="memberSearch" oninput="filterTable()" placeholder="Cari nama anggota..." class="w-full pl-9 pr-4 py-2 bg-surface-container-low rounded-xl text-xs text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary transition-all">
      </div>
      <div class="hidden sm:flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs text-on-surface-variant px-2.5 py-1.5 bg-surface-container-low rounded-lg font-medium">
          <span class="w-4 h-4 rounded bg-emerald-600 text-white inline-flex items-center justify-center"><svg class="w-2.5 h-2.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span> Sudah Bayar
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs text-on-surface-variant px-2.5 py-1.5 bg-surface-container-low rounded-lg font-medium">
          <span class="w-4 h-4 rounded bg-amber-500 text-white inline-flex items-center justify-center font-bold text-[10px]">!</span> Kena Denda
        </span>
      </div>
    </div>
  </div>

  <!-- Step Pagination Bar per 10 Minggu -->
  <div class="mb-4 p-3 bg-surface-container-low/70 rounded-2xl border border-surface-container flex flex-col md:flex-row items-center justify-between gap-3">
    <!-- Tombol Prev / Next & Batch Pills (Bisa di-swipe halus di HP) -->
    <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto py-1 justify-start">
      <button id="prevBatchBtn" onclick="prevBatch()" class="shrink-0 px-3 py-1.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-xs font-semibold text-primary disabled:opacity-30 disabled:cursor-not-allowed transition-all flex items-center gap-1">
        <span class="material-symbols-outlined text-[16px]">chevron_left</span> <span class="hidden sm:inline">Sebelumnya</span>
      </button>

      <div class="flex items-center gap-1 shrink-0">
        <button onclick="setBatch(0)" class="batch-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap" data-index="0">M 1-10</button>
        <button onclick="setBatch(1)" class="batch-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap" data-index="1">M 11-20</button>
        <button onclick="setBatch(2)" class="batch-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap" data-index="2">M 21-30</button>
        <button onclick="setBatch(3)" class="batch-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap" data-index="3">M 31-40</button>
        <button onclick="setBatch(4)" class="batch-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap" data-index="4">M 41-50</button>
        <button onclick="setBatch(5)" class="batch-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap" data-index="5">M 51-52</button>
      </div>

      <button id="nextBatchBtn" onclick="nextBatch()" class="shrink-0 px-3 py-1.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-xs font-semibold text-primary disabled:opacity-30 disabled:cursor-not-allowed transition-all flex items-center gap-1">
        <span class="hidden sm:inline">Berikutnya</span> <span class="material-symbols-outlined text-[16px]">chevron_right</span>
      </button>
    </div>

    <!-- Active Range Label -->
    <div class="text-xs font-medium text-primary flex items-center gap-1.5 shrink-0 self-center">
      <span class="w-2 h-2 rounded-full bg-secondary"></span>
      <span>Menampilkan: <strong id="batchInfoText" class="text-secondary font-bold">Minggu 1 - 10</strong></span>
    </div>
  </div>

  <!-- Table Container (Horizontal Scroll with Sticky Name Column) -->
  <div class="overflow-x-auto rounded-xl border border-surface-container shadow-xs">
    <table class="w-full text-left border-collapse text-xs" id="paymentTable">
      <thead>
        <tr class="bg-surface-container-low text-on-surface-variant uppercase text-[11px] font-semibold tracking-wider">
          <th class="py-3 px-3 sm:px-4 sticky left-0 bg-surface-container-low z-20 border-r border-surface-container min-w-[140px] sm:min-w-[200px] shadow-[2px_0_5px_rgba(0,0,0,0.04)]">
            Nama Anggota
          </th>
          <% weeks.forEach(function(w) { 
            const batchIdx = Math.floor((w.number - 1) / 10);
          %>
            <th class="py-3.5 px-3 text-center whitespace-nowrap min-w-[96px] border-r border-surface-container/60 week-col week-batch-<%= batchIdx %>">
              <div class="font-bold text-primary">M<%= w.number %></div>
              <div class="text-[10px] text-on-surface-variant font-normal"><%= w.from.getDate() %>/<%= w.from.getMonth()+1 %>-<%= w.to.getDate() %>/<%= w.to.getMonth()+1 %></div>
            </th>
          <% }) %>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-container">
        <% anggota.forEach(function(a, idx) { 
          const parts = a.nama.trim().split(' ');
          const initial = (parts[0][0] + (parts.length > 1 ? parts[1][0] : '')).toUpperCase();
        %>
          <tr class="hover:bg-surface-container-low/60 transition-colors" data-nama="<%= a.nama.toLowerCase() %>">
            <!-- Sticky Name Cell (Mobile-Friendly) -->
            <td class="py-2.5 px-3 sm:px-4 sticky left-0 bg-surface-container-lowest z-10 border-r border-surface-container font-medium text-primary shadow-[2px_0_5px_rgba(0,0,0,0.03)]">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[9px] sm:text-[10px] shrink-0">
                  <%= initial %>
                </div>
                <span class="truncate max-w-[110px] sm:max-w-none text-xs"><%= a.nama %></span>
              </div>
            </td>

            <!-- Weekly Checkboxes -->
            <% weeks.forEach(function(w) { 
              const batchIdx = Math.floor((w.number - 1) / 10);
              const key = a.id + '_' + w.dateStr;
              const p = payments[key];
              const bayar = p ? p.apakah_bayar : false;
              const denda = p ? p.kena_denda : false;
            %>
              <td class="py-2.5 px-2 text-center whitespace-nowrap border-r border-surface-container/40 week-col week-batch-<%= batchIdx %>">
                <div class="inline-flex items-center gap-1">
                  <!-- Checkbox Bayar (Ceklis ✓) -->
                  <label class="<%= isAdmin ? 'cursor-pointer' : 'cursor-default' %>" title="<%= isAdmin ? (bayar ? 'Klik untuk membatalkan bayar' : 'Klik untuk menandai sudah bayar') : (bayar ? 'Sudah Bayar Kas' : 'Belum Bayar') %>">
                    <input type="checkbox" class="sr-only peer"
                      data-anggota="<%= a.id %>" data-tanggal="<%= w.dateStr %>"
                      <%= bayar ? 'checked' : '' %>
                      <%= !isAdmin ? 'disabled' : '' %>
                      onchange="toggleKas(this, 'apakah_bayar')">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-md border border-surface-container-highest bg-white peer-checked:bg-emerald-600 peer-checked:border-emerald-600 text-transparent peer-checked:text-white transition-all shadow-xs <%= isAdmin ? 'hover:border-emerald-500' : '' %>">
                      <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    </span>
                  </label>

                  <!-- Checkbox Denda (Tanda !) -->
                  <label class="<%= isAdmin ? 'cursor-pointer' : 'cursor-default' %>" title="<%= isAdmin ? (denda ? 'Klik untuk membatalkan denda' : 'Klik untuk mengenakan denda') : (denda ? 'Kena Denda Keterlambatan' : 'Bebas Denda') %>">
                    <input type="checkbox" class="sr-only peer"
                      data-anggota="<%= a.id %>" data-tanggal="<%= w.dateStr %>"
                      <%= denda ? 'checked' : '' %>
                      <%= !isAdmin ? 'disabled' : '' %>
                      onchange="toggleKas(this, 'kena_denda')">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-md border border-surface-container-highest bg-white peer-checked:bg-amber-500 peer-checked:border-amber-500 text-transparent peer-checked:text-white transition-all shadow-xs <%= isAdmin ? 'hover:border-amber-400' : '' %>">
                      <span class="font-bold text-[11px] leading-none">!</span>
                    </span>
                  </label>
                </div>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
const IS_ADMIN = <%= isAdmin ? 'true' : 'false' %>;

/* ── Pagination per 10 Minggu ────────────────────────── */
let currentBatch = 0;
const totalBatches = 6;
const batchLabels = [
  'Minggu 1 - 10 (24 Ags - 01 Nov 2026)',
  'Minggu 11 - 20 (02 Nov 2026 - 10 Jan 2027)',
  'Minggu 21 - 30 (11 Jan - 21 Mar 2027)',
  'Minggu 31 - 40 (22 Mar - 30 Mei 2027)',
  'Minggu 41 - 50 (31 Mei - 08 Ags 2027)',
  'Minggu 51 - 52 (09 Ags - 22 Ags 2027)'
];

function setBatch(batchIndex) {
  if (batchIndex < 0 || batchIndex >= totalBatches) return;
  currentBatch = batchIndex;

  // Toggle column visibility
  document.querySelectorAll('.week-col').forEach(el => {
    el.style.display = el.classList.contains('week-batch-' + currentBatch) ? '' : 'none';
  });

  // Update batch pills
  document.querySelectorAll('.batch-btn').forEach((btn) => {
    const idx = parseInt(btn.dataset.index, 10);
    if (idx === currentBatch) {
      btn.className = 'batch-btn px-3 py-1.5 rounded-xl bg-secondary text-white font-bold text-xs shadow-xs transition-all';
    } else {
      btn.className = 'batch-btn px-3 py-1.5 rounded-xl bg-surface-container text-on-surface-variant hover:bg-surface-container-high text-xs font-medium transition-all';
    }
  });

  // Prev / Next button state
  document.getElementById('prevBatchBtn').disabled = currentBatch === 0;
  document.getElementById('nextBatchBtn').disabled = currentBatch === totalBatches - 1;

  // Update label
  document.getElementById('batchInfoText').textContent = batchLabels[currentBatch];
}

function prevBatch() {
  if (currentBatch > 0) setBatch(currentBatch - 1);
}

function nextBatch() {
  if (currentBatch < totalBatches - 1) setBatch(currentBatch + 1);
}

// Inisialisasi awal pada batch 0 (Minggu 1 - 10)
setBatch(0);

/* ── Live Toggle Kas via AJAX ────────────────────────── */
function formatRp(n) {
  return 'Rp ' + (n||0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

function toggleKas(el, field) {
  if (!IS_ADMIN) {
    alert('Hanya Administrator yang memiliki akses untuk mengubah data kas.');
    el.checked = !el.checked;
    return;
  }

  const aid = el.dataset.anggota;
  const tgl = el.dataset.tanggal;
  const val = el.checked;

  fetch('/kas/toggle', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
    body: JSON.stringify({ anggota_id: parseInt(aid), tanggal_periode: tgl, field: field, value: val })
  })
  .then(r => {
    if (!r.ok) throw new Error('Unauthorized');
    return r.json();
  })
  .then(d => {
    if (d.ok) {
      document.getElementById('val-kas').textContent = formatRp(d.totalKas);
      document.getElementById('val-denda').textContent = formatRp(d.totalDenda);
      document.getElementById('val-pengeluaran').textContent = formatRp(d.totalPengeluaran);
      document.getElementById('val-saldo').textContent = formatRp(d.sisaSaldo);
    }
  })
  .catch((e) => {
    alert('Gagal memperbarui data. Pastikan Anda sudah masuk sebagai admin.');
    el.checked = !el.checked;
  });
}

function filterTable() {
  const q = document.getElementById('memberSearch').value.toLowerCase();
  document.querySelectorAll('#paymentTable tbody tr').forEach(function(tr) {
    tr.style.display = tr.dataset.nama.includes(q) ? '' : 'none';
  });
}
</script>

<%- include('partials/foot') %>
